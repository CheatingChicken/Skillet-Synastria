{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.1"
  },
  "diagnostics": {
    "enable": true,
    "globals": [
      "AceLibrary",
      "UIDropDownMenu_AddButton",
      "UIDropDownMenu_Initialize",
      "UIDropDownMenu_SetSelectedValue",
      "UIDropDownMenu_GetSelectedValue",
      "GameTooltip",
      "DEFAULT_CHAT_FRAME",
      "assert",
      "UnitName",
      "GetItemCount",
      "GetCustomGameData",
      "SkilletItemCountInputBox",
      "GetItemInfo",
      "GetTradeSkillInfo",
      "GetTradeSkillNumReagents",
      "GetTradeSkillReagentInfo",
      "GetTradeSkillReagentItemLink",
      "GetNumTradeSkills",
      "GetTradeSkillLine",
      "GetTradeSkillIcon",
      "DoTradeSkill",
      "CloseTradeSkill",
      "CastSpellByName",
      "GetContainerNumSlots",
      "GetContainerItemInfo",
      "GetContainerItemLink",
      "PickupContainerItem",
      "CursorHasItem",
      "DeleteCursorItem",
      "GetCursorInfo",
      "StaticPopup_Show",
      "IsShiftKeyDown",
      "IsControlKeyDown",
      "IsAltKeyDown",
      "GetTradeSkillRecipeLink",
      "GetItemQualityColor",
      "SlashCmdList",
      "CreateFrame",
      "select",
      "_G",
      "getglobal",
      "GRAY_FONT_COLOR_CODE",
      "FONT_COLOR_CODE_CLOSE",
      "COOLDOWN_REMAINING",
      "SecondsToTime",
      "FauxScrollFrame_Update",
      "FauxScrollFrame_GetOffset",
      "SKILLET_TRADE_SKILL_HEIGHT",
      "SKILLET_NUM_REAGENT_BUTTONS",
      "GetCVar",
      "GetTradeSkillCooldown",
      "this",
      "TradeSkillFrame",
      "TradeJunkieMain",
      "TJ_OpenButtonTradeSkill",
      "AC_Craft",
      "AC_UseButton",
      "AC_ToggleButton"
    ],
    "disable": ["inject-field", "missing-parameter", "redundant-parameter"],
    "severity": {
      "need-check-nil": "Warning",
      "undefined-field": "Hint",
      "param-type-mismatch": "Warning",
      "assign-type-mismatch": "Warning",
      "return-type-mismatch": "Warning",
      "cast-type-mismatch": "Warning",
      "inject-field": "Warning",
      "undefined-global": "Warning",
      "lowercase-global": "Hint",
      "missing-return": "Hint",
      "missing-return-value": "Hint",
      "redundant-return-value": "Hint",
      "unused-local": "Hint",
      "unused-function": "Hint",
      "deprecated": "Hint",
      "different-requires": "Hint",
      "no-unknown": "Hint",
      "duplicate-index": "Error"
    }
  },
  "meta": {
    "version": "Lua 5.1"
  },
  "workspace": {
    "library": [
      "./src/Skillet - Synastria"
    ]
  }
}
